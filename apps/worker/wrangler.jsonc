{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fliptoons",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],

  "observability": { "enabled": true },

  "routes": [
    { "pattern": "fliptoons.win", "custom_domain": true },
    { "pattern": "www.fliptoons.win", "custom_domain": true }
  ],

  "env": {
    "beta": {
      "name": "fliptoons-beta",
      "main": "worker.ts",
      "compatibility_date": "2026-08-01",

      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "run_worker_first": true
      },

      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],

      "observability": { "enabled": true },

      "routes": [{ "pattern": "beta.fliptoons.win", "custom_domain": true }]
    }
  }
}
